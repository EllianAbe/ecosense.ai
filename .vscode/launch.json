{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "src/app.py",
            ],
            "console": "integratedTerminal", // or "internalConsole"
            "justMyCode": true // Set to false to debug into Streamlit's internal code
        }
    ]
}